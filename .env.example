# AgriLink Control environment variables
# Copy to .env.local and fill in values. Never commit real secrets.

# Set only after the approved shared admin API base URL and identity contract are provided.
VITE_API_BASE_URL=

# Application name
VITE_APP_NAME=AgriLink Control

# Feature flags (enabled only when the corresponding backend capability is proven available)
VITE_AI_CONTROL_ENABLED=false
VITE_MARKET_INTELLIGENCE_ENABLED=false

# NOTE: NVIDIA API keys and provider secrets MUST be stored on the backend only.
# Never set them here, never expose them to browser code or VITE_* variables.
